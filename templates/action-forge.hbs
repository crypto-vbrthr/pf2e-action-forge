<section class="af-shell {{#if interactionLocked}}is-busy{{/if}}" {{#if interactionLocked}}aria-busy="true"{{/if}}>
  <header class="af-header">
    <div class="af-brand">
      <span class="af-brand-icon" aria-hidden="true"><i class="fa-solid fa-hammer"></i></span>
      <div>
        <h1>{{localize "PF2EActionForge.Title"}}</h1>
        <p>{{localize "PF2EActionForge.Subtitle"}}</p>
      </div>
    </div>
    <span class="af-version">{{moduleVersion}}</span>
  </header>

  <section class="af-source-panel" aria-labelledby="af-source-heading">
    <div class="af-section-heading">
      <div>
        <h2 id="af-source-heading">{{localize "PF2EActionForge.SourceActor.Label"}}</h2>
        <p>{{localize "PF2EActionForge.SourceActor.Hint"}}</p>
      </div>
    </div>

    {{#if actor}}
      <div class="af-actor-row">
        <img class="af-actor-portrait" src="{{actor.img}}" alt="" />
        <div class="af-actor-summary">
          <strong>{{actor.name}}</strong>
          <span>{{actor.sourceText}}</span>
        </div>
        <label class="af-visually-hidden" for="af-source-actor">{{localize "PF2EActionForge.SourceActor.Select"}}</label>
        <select id="af-source-actor" data-role="source-actor" {{#if sourceActorLocked}}disabled{{/if}}>
          <option value="{{currentTokenSelectionValue}}" {{#if followsCurrentToken}}selected{{/if}}>
            {{localize "PF2EActionForge.SourceActor.CurrentToken"}}
          </option>
          {{#each actors}}
            <option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>
          {{/each}}
        </select>
        {{#if sourceActorLocked}}
          <span class="af-source-lock" title="{{localize 'PF2EActionForge.SourceActor.LockedHint'}}">
            <i class="fa-solid fa-lock" aria-hidden="true"></i>
            {{localize "PF2EActionForge.SourceActor.Locked"}}
          </span>
        {{/if}}
      </div>
    {{else}}
      <div class="af-empty-state af-empty-state--warning">
        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
        <div>
          <strong>{{localize "PF2EActionForge.SourceActor.NoneTitle"}}</strong>
          <span>{{localize "PF2EActionForge.SourceActor.NoneHint"}}</span>
        </div>
      </div>
    {{/if}}
  </section>

  {{#if activeAction}}
    <section class="af-target-panel" aria-labelledby="af-target-heading">
      <div class="af-target-header">
        <div class="af-selected-action">
          <span class="af-action-icon" aria-hidden="true"><i class="{{activeAction.icon}}"></i></span>
          <div>
            <span class="af-eyebrow">{{localize "PF2EActionForge.Target.SelectedAction"}}</span>
            <h2 id="af-target-heading">{{activeAction.labelText}}</h2>
          </div>
        </div>
        <div class="af-target-header-actions">
          <span class="af-target-mode"><i class="fa-solid fa-crosshairs" aria-hidden="true"></i> {{targetContext.modeLabel}}</span>
          <button
            type="button"
            class="af-icon-button"
            data-action="closeActionSelection"
            title="{{localize 'PF2EActionForge.Target.Close'}}"
            aria-label="{{localize 'PF2EActionForge.Target.Close'}}"
            {{#if executionInFlight}}disabled{{/if}}
          >
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
          </button>
        </div>
      </div>

      {{#if targetContext.allowsTargets}}
        <p class="af-target-hint">{{targetContext.hint}}</p>

        <div class="af-target-tools">
          <button type="button" class="af-secondary-button" data-action="useCanvasTargets" {{#if interactionLocked}}disabled{{/if}}>
            <i class="fa-solid fa-bullseye" aria-hidden="true"></i>
            {{localize "PF2EActionForge.Target.UseCanvas"}}
          </button>
          {{#if targetContext.canUsePicker}}
            <button type="button" class="af-secondary-button" data-action="pickTarget" {{#if interactionLocked}}disabled{{/if}}>
              <i class="fa-solid fa-users" aria-hidden="true"></i>
              {{localize "PF2EActionForge.Target.Picker.Button"}}
            </button>
          {{/if}}
          <span class="af-canvas-target-count">
            {{localize "PF2EActionForge.Target.CanvasTargets"}}: {{targetContext.canvasCount}}
          </span>
        </div>

        <div class="af-target-drop-zone {{#if interactionLocked}}is-locked{{/if}}" data-role="target-drop-zone">
          <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
          <div>
            <strong>{{localize "PF2EActionForge.Target.DropTitle"}}</strong>
            <span>{{localize "PF2EActionForge.Target.DropHint"}}</span>
          </div>
        </div>

        {{#if targetContext.count}}
          <div class="af-target-list" aria-label="{{localize 'PF2EActionForge.Target.Current'}}">
            {{#each targetContext.targets}}
              <div class="af-target-chip">
                <img src="{{img}}" alt="" />
                <span class="af-target-chip-copy">
                  <strong>{{name}}</strong>
                  <small>{{sourceText}}</small>
                </span>
                <button
                  type="button"
                  class="af-target-remove"
                  data-action="removeTarget"
                  data-target-key="{{key}}"
                  {{#if ../interactionLocked}}disabled{{/if}}
                  title="{{localize 'PF2EActionForge.Target.Remove'}}"
                  aria-label="{{localize 'PF2EActionForge.Target.Remove'}}"
                >
                  <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
              </div>
            {{/each}}
          </div>
        {{else}}
          <div class="af-target-empty">
            <i class="fa-regular fa-circle-dot" aria-hidden="true"></i>
            <span>{{localize "PF2EActionForge.Target.NoneSelected"}}</span>
          </div>
        {{/if}}

        {{#if targetContext.canvasOverflow}}
          <div class="af-inline-warning">
            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
            <span>{{localize "PF2EActionForge.Target.SingleOverflow"}}</span>
          </div>
        {{/if}}

        <div class="af-target-status {{#if targetContext.valid}}is-valid{{else}}is-required{{/if}}">
          <i class="fa-solid {{#if targetContext.valid}}fa-check{{else}}fa-circle-exclamation{{/if}}" aria-hidden="true"></i>
          <span>
            {{#if targetContext.valid}}
              {{localize "PF2EActionForge.Target.Ready"}}
            {{else}}
              {{localize "PF2EActionForge.Target.Required"}}
            {{/if}}
          </span>
        </div>
      {{else}}
        <div class="af-target-none">
          <i class="fa-solid fa-mountain" aria-hidden="true"></i>
          <div>
            <strong>{{localize "PF2EActionForge.Target.NoTargetTitle"}}</strong>
            <span>{{targetContext.hint}}</span>
          </div>
        </div>
      {{/if}}
    </section>

    <section class="af-dc-panel" aria-labelledby="af-dc-heading">
      <div class="af-dc-header">
        <div>
          <span class="af-eyebrow">{{localize "PF2EActionForge.DC.Eyebrow"}}</span>
          <h3 id="af-dc-heading">{{localize "PF2EActionForge.DC.Heading"}}</h3>
        </div>
        <span class="af-dc-source"><i class="fa-solid fa-gauge-high" aria-hidden="true"></i> {{dcContext.sourceText}}</span>
      </div>

      {{#if statisticContext}}
        <label class="af-statistic-input">
          <span>
            <strong>{{statisticContext.label}}</strong>
            <small>{{statisticContext.hint}}</small>
          </span>
          <select data-role="execution-statistic" {{#if interactionLocked}}disabled{{/if}}>
            <option value="" {{#unless statisticContext.selected}}selected{{/unless}}>{{localize "PF2EActionForge.Roll.StatisticPlaceholder"}}</option>
            {{#each statisticContext.options}}
              <option value="{{slug}}" {{#if selected}}selected{{/if}}>{{displayLabel}}</option>
            {{/each}}
          </select>
        </label>
      {{/if}}

      {{#if dcContext.showChoiceSelect}}
        <label class="af-dc-input af-dc-choice">
          <span>
            <strong>{{dcContext.choiceLabel}}</strong>
            <small>{{dcContext.choiceHint}}</small>
          </span>
          <select data-role="fixed-choice-dc" {{#if interactionLocked}}disabled{{/if}}>
            {{#each dcContext.choiceOptions}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </label>
      {{/if}}

      {{#if dcContext.showManualInput}}
        <label class="af-dc-input">
          <span>
            <strong>{{dcContext.manualInputLabel}}</strong>
            <small>{{dcContext.manualInputHint}}</small>
          </span>
          <input
            data-role="manual-dc"
            type="number"
            min="0"
            max="60"
            step="1"
            value="{{dcContext.manualInputValue}}"
            inputmode="numeric"
            {{#if interactionLocked}}disabled{{/if}}
          />
        </label>
      {{/if}}

      <div class="af-dc-status {{dcContext.statusClass}}" data-role="dc-status">
        <i class="fa-solid {{#if dcContext.waitingForGmDc}}fa-hourglass-half{{else}}{{#if dcContext.handoffRequired}}fa-hourglass-half{{else}}{{#if dcContext.valid}}fa-check{{else}}fa-circle-exclamation{{/if}}{{/if}}{{/if}}" aria-hidden="true"></i>
        <span>{{dcContext.statusText}}</span>
      </div>

      {{#if visibilityContext}}
        <div class="af-visibility-panel {{#if visibilityContext.secret}}is-secret{{/if}}">
          <div class="af-visibility-heading">
            <i class="fa-solid {{#if visibilityContext.secret}}fa-user-secret{{else}}fa-eye{{/if}}" aria-hidden="true"></i>
            <strong>{{localize "PF2EActionForge.Visibility.Heading"}}</strong>
          </div>
          <div class="af-visibility-grid">
            {{#each visibilityContext.rows}}
              <span>{{label}}</span><strong>{{value}}</strong>
            {{/each}}
          </div>
        </div>
      {{/if}}

      {{#if executionContext.constraintText}}
        <div class="af-inline-warning">
          <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
          <span>{{executionContext.constraintText}}</span>
        </div>
      {{/if}}

      <div class="af-roll-actions">
        {{#if executionContext.enabled}}
          {{#if executionContext.systemActionAvailable}}
            <button
              type="button"
              class="af-primary-button"
              data-action="executeAction"
              {{#unless executionContext.canExecute}}disabled{{/unless}}
            >
              <i class="fa-solid fa-dice-d20" aria-hidden="true"></i>
              {{executionContext.buttonText}}
            </button>
          {{else}}
            <div class="af-roll-unavailable">
              <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
              <span>{{executionContext.unavailableText}}</span>
            </div>
          {{/if}}
        {{else}}
          <div class="af-roll-unavailable is-planned">
            <i class="fa-solid fa-hourglass-half" aria-hidden="true"></i>
            <span>{{executionContext.unavailableText}}</span>
          </div>
        {{/if}}

      </div>
    </section>
  {{/if}}

  {{#if lastRoll}}
    <section class="af-roll-result af-roll-result--summary {{#if lastRoll.hidden}}is-hidden-result{{/if}}" role="status">
      <i class="fa-solid {{#if lastRoll.hidden}}fa-user-secret{{else}}fa-dice-d20{{/if}}" aria-hidden="true"></i>
      {{#if lastRoll.hidden}}
        <span>{{localize "PF2EActionForge.Roll.LastResult"}} · {{lastRoll.actionName}} · {{lastRoll.actorName}}:</span>
        <strong>{{lastRoll.hiddenText}}</strong>
      {{else}}
        <span>{{localize "PF2EActionForge.Roll.LastResult"}} · {{lastRoll.actionName}} · {{lastRoll.actorName}}:</span>
        <strong>{{lastRoll.total}}</strong>
        <span>· {{lastRoll.outcomeText}}</span>
      {{/if}}
    </section>
  {{/if}}

  <section class="af-actions" aria-labelledby="af-actions-heading">
    <div class="af-actions-toolbar">
      <div class="af-section-heading">
        <div>
          <h2 id="af-actions-heading">{{localize "PF2EActionForge.Actions.Heading"}}</h2>
          <p>{{localize "PF2EActionForge.Actions.CatalogHint"}}</p>
        </div>
      </div>
      <label class="af-search" for="af-action-search">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <span class="af-visually-hidden">{{localize "PF2EActionForge.Search.Label"}}</span>
        <input
          id="af-action-search"
          type="search"
          value="{{searchQuery}}"
          placeholder="{{localize 'PF2EActionForge.Search.Placeholder'}}"
          autocomplete="off"
          data-role="action-search"
        />
      </label>
    </div>

    {{#if hasActions}}
      {{#if hasFavorites}}
        <section class="af-action-group af-favorites" data-action-group="favorites">
          <div class="af-category-heading">
            <h3><i class="fa-solid fa-star" aria-hidden="true"></i> {{localize "PF2EActionForge.Favorites.Heading"}}</h3>
            <span>{{localize "PF2EActionForge.Favorites.Hint"}}</span>
          </div>
          <div class="af-action-grid">
            {{#each favoriteActions}}
              <article class="af-action-card {{#if isActive}}is-active{{/if}}" data-action-card data-search-text="{{searchText}}">
                <button
                  type="button"
                  class="af-action-run"
                  data-action="runAction"
                  data-action-id="{{id}}"
                  {{#unless ../actor}}disabled{{/unless}} {{#if ../interactionLocked}}disabled{{/if}}
                >
                  <span class="af-action-icon" aria-hidden="true"><i class="{{icon}}"></i></span>
                  <span class="af-action-copy">
                    <strong>{{labelText}}</strong>
                    {{#if descriptionText}}<small>{{descriptionText}}</small>{{/if}}
                    <span class="af-action-meta"><i class="fa-solid fa-crosshairs" aria-hidden="true"></i> {{targetModeText}}</span>
                  </span>
                </button>
                <button
                  type="button"
                  class="af-favorite-toggle is-favorite"
                  data-action="toggleFavorite"
                  data-action-id="{{id}}"
                  title="{{favoriteLabel}}"
                  aria-label="{{favoriteLabel}}"
                  aria-pressed="true"
                  {{#if ../interactionLocked}}disabled{{/if}}
                >
                  <i class="fa-solid fa-star" aria-hidden="true"></i>
                </button>
              </article>
            {{/each}}
          </div>
        </section>
      {{/if}}

      <div class="af-catalog">
        {{#each categories}}
          <section class="af-action-group" data-action-group="{{id}}">
            <div class="af-category-heading">
              <h3><i class="{{icon}}" aria-hidden="true"></i> {{label}}</h3>
            </div>
            <div class="af-action-grid">
              {{#each actions}}
                <article class="af-action-card {{#if isActive}}is-active{{/if}}" data-action-card data-search-text="{{searchText}}">
                  <button
                    type="button"
                    class="af-action-run"
                    data-action="runAction"
                    data-action-id="{{id}}"
                    {{#unless ../../actor}}disabled{{/unless}} {{#if ../../interactionLocked}}disabled{{/if}}
                  >
                    <span class="af-action-icon" aria-hidden="true"><i class="{{icon}}"></i></span>
                    <span class="af-action-copy">
                      <strong>{{labelText}}</strong>
                      {{#if descriptionText}}<small>{{descriptionText}}</small>{{/if}}
                      <span class="af-action-meta"><i class="fa-solid fa-crosshairs" aria-hidden="true"></i> {{targetModeText}}</span>
                    </span>
                  </button>
                  <button
                    type="button"
                    class="af-favorite-toggle {{#if isFavorite}}is-favorite{{/if}}"
                    data-action="toggleFavorite"
                    data-action-id="{{id}}"
                    title="{{favoriteLabel}}"
                    aria-label="{{favoriteLabel}}"
                    aria-pressed="{{#if isFavorite}}true{{else}}false{{/if}}"
                    {{#if ../../interactionLocked}}disabled{{/if}}
                  >
                    <i class="{{#if isFavorite}}fa-solid{{else}}fa-regular{{/if}} fa-star" aria-hidden="true"></i>
                  </button>
                </article>
              {{/each}}
            </div>
          </section>
        {{/each}}
      </div>

      <div class="af-empty-state" data-role="search-empty" hidden>
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <span>{{localize "PF2EActionForge.Search.Empty"}}</span>
      </div>
    {{else}}
      <div class="af-empty-state">
        <i class="fa-solid fa-box-open" aria-hidden="true"></i>
        <span>{{localize "PF2EActionForge.Actions.Empty"}}</span>
      </div>
    {{/if}}
  </section>

  <footer class="af-footer">
    <span><i class="fa-solid fa-crosshairs" aria-hidden="true"></i> {{localize "PF2EActionForge.Footer.Catalog"}}</span>
  </footer>
</section>
